# SPDX-License-Identifier: GPL-2.0
# LFD430 labs - shared settings.  Sourced by env/scripts/*.sh and read by
# common/Makefile.module.  Override any variable from your shell, e.g.
#   export LFD_KSRC=$HOME/src/linux-6.12
# Keep the syntax "NAME ?= value": it is valid for both make and the
# tiny parser in env/scripts/common.sh.

# Linux v6.12 source tree (git clone or tarball from kernel.org).
LFD_KSRC ?= $(HOME)/lfd430/linux-6.12
# Out-of-tree build directories, one per target (x86_64, arm64, bbb).
LFD_KBUILD ?= $(HOME)/lfd430/kbuild
# Root filesystem images (initramfs) built by mk-initramfs.sh.
LFD_IMAGES ?= $(HOME)/lfd430/images
# Cross compilers (Ubuntu: gcc-aarch64-linux-gnu, gcc-arm-linux-gnueabihf).
LFD_CROSS_arm64 ?= aarch64-linux-gnu-
LFD_CROSS_bbb ?= arm-linux-gnueabihf-
# BeagleBone Black: NFS root file system and TFTP directory
# (env/scripts/mk-bbb-rootfs.sh, "make install" in the BBB labs).
LFD_BBB_ROOTFS ?= $(HOME)/lfd430/bbb/rootfs
LFD_BBB_TFTP ?= $(HOME)/lfd430/bbb/tftp
# Host tools built from source (env/scripts/build-sparse.sh).
LFD_TOOLS ?= $(HOME)/lfd430/tools
# QEMU guest RAM (MiB).  Keep it > 256 MiB: Lab 20 relies on it.
LFD_MEM ?= 512
