# SPDX-License-Identifier: GPL-2.0
#
# LFD430 labs - kernel configuration fragment for QEMU x86_64 (q35).
# Applied on top of: x86_64_defconfig + kernel/configs/kvm_guest.config
# by env/scripts/build-kernel.sh.  Target kernel: Linux v6.12.
#
CONFIG_LOCALVERSION="-lfd430"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Modules -------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
# CONFIG_MODVERSIONS is not set

# --- Preemption: one kernel, three models (boot with preempt=none|voluntary|full)
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_250=y

# --- Boot / root filesystem ----------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_EXT2_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y

# --- Debugging (Deck 00 Part "Debugging", Lab 02) -------------------------
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_GDB_SCRIPTS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_SLUB_DEBUG=y
CONFIG_DMA_API_DEBUG=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# --- Power management (Lab 23) --------------------------------------------
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# --- Devices used by the labs ----------------------------------------------
# PCI 'edu' teaching device: no in-tree driver.  User-space drivers (Lab 12):
CONFIG_UIO=m
CONFIG_UIO_PCI_GENERIC=m
# Lab 21 writes its own RTL8139 driver: keep the in-tree ones out of the way.
# CONFIG_8139TOO is not set
# CONFIG_8139CP is not set
CONFIG_E1000=y
# Lab 22 writes a USB mouse driver: make usbhid a module so it can be unbound.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_HID=y
CONFIG_USB_HID=m
CONFIG_INPUT_EVDEV=y
# Lab 17 writes its own 16550 driver for COM2.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_RTC_CLASS=y
CONFIG_BLK_DEV_LOOP=y

# --- Not needed for -nographic labs: keep build time down ---------------------
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_CFG80211 is not set
# CONFIG_AGP is not set
# CONFIG_HAMRADIO is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_INFINIBAND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_NFS_FS is not set
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set
