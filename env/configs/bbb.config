# SPDX-License-Identifier: GPL-2.0
#
# LFD430 labs - kernel configuration fragment for the BeagleBone Black.
# Applied on top of omap2plus_defconfig by env/scripts/build-kernel.sh bbb.
# Note: in v6.12 mainline, 32-bit ARM does not select ARCH_SUPPORTS_RT,
# so PREEMPT_RT needs the out-of-tree -rt patch set on this board.
#
CONFIG_LOCALVERSION="-lfd430"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_GPIO_CDEV=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_GPIO_OMAP=y
CONFIG_SERIAL_8250_OMAP=y
