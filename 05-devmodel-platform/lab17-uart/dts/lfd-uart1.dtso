/*
 * Lab 17 part 2: give the AM335x UART1 (0x48022000, IRQ 73; disabled on the
 * BeagleBone Black) to lfd_uart.  The tests use the UART's internal
 * loopback (MCR bit 4), so no pin multiplexing or wiring is needed.
 * UART1 sits below a "ti,sysc" interconnect target: the driver must take a
 * runtime-PM reference before touching any register.
 */
/dts-v1/;
/plugin/;

&uart1 {
